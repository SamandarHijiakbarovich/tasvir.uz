{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "content": {
        "ClusterId": "core-api",
        "Match": { "Path": "/api/content/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "core-api",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      },
      "academy": {
        "ClusterId": "core-api",
        "Match": { "Path": "/api/academy/{**catch-all}" }
      },
      "studio": {
        "ClusterId": "core-api",
        "Match": { "Path": "/api/studio/{**catch-all}" }
      },
      "assistant": {
        "ClusterId": "core-api",
        "Match": { "Path": "/api/assistant/{**catch-all}" },
        "Transforms": [ { "X-Forwarded": "Append" } ]
      }
    },
    "Clusters": {
      "core-api": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5100/" }
        }
      }
    }
  }
}
